<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base Liquid Glass Theme with Material Components -->
    <style name="HorizonLauncherTheme" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="android:windowBackground">@color/pitch_obsidian</item>
        <item name="android:colorBackground">@color/pitch_obsidian</item>
        <item name="android:statusBarColor">@color/pitch_obsidian</item>
        <item name="android:navigationBarColor">@color/pitch_obsidian</item>
        <item name="colorPrimary">@color/titanium_silver</item>
        <item name="colorSecondary">@color/cool_ash_grey</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>

    <!-- Game Process Theme -->
    <style name="HorizonGameTheme" parent="Theme.AppCompat.NoActionBar">
        <item name="android:windowBackground">@color/pitch_obsidian</item>
        <item name="android:colorBackground">@color/pitch_obsidian</item>
        <item name="android:statusBarColor">@color/pitch_obsidian</item>
        <item name="android:navigationBarColor">@color/pitch_obsidian</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
        <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
    </style>
</resources>
