<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/gameRootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <!-- 1. Virtual Mouse Touchpad and Camera Look Area (Full Screen) -->
    <com.mattz1415.horizon.ui.VirtualTouchpadView
        android:id="@+id/virtualTouchpadView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- 2. Pojav / Zalith Top Utility Header Bar -->
    <HorizontalScrollView
        android:id="@+id/topBarScrollView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:scrollbars="none"
        android:overScrollMode="never">

        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:gravity="center_vertical">

            <!-- Toggle GUI visibility (Hide/Show on-screen controls) -->
            <Button
                android:id="@+id/btnGui"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:background="@drawable/bg_control_button"
                android:text="GUI"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Toggle Virtual Mouse Mode ON / OFF -->
            <Button
                android:id="@+id/btnMouse"
                android:layout_width="66dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_button_active"
                android:text="MOUSE"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Open Android Soft Keyboard -->
            <Button
                android:id="@+id/btnKbd"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_button"
                android:text="KBD"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- ESC / Pause -->
            <Button
                android:id="@+id/btnEsc"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_button"
                android:text="ESC"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- F3 / Debug screen -->
            <Button
                android:id="@+id/btnF3"
                android:layout_width="52dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_button"
                android:text="F3"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- F5 / Perspective toggle (1st/3rd person) -->
            <Button
                android:id="@+id/btnF5"
                android:layout_width="52dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_button"
                android:text="F5"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- CHAT / T -->
            <Button
                android:id="@+id/btnChat"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_button"
                android:text="CHAT"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- TAB / Player list -->
            <Button
                android:id="@+id/btnTab"
                android:layout_width="52dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_button"
                android:text="TAB"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- INV / Inventory (E) -->
            <Button
                android:id="@+id/btnInv"
                android:layout_width="56dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_button"
                android:text="INV"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- LAYOUT / Touch Layout Studio -->
            <Button
                android:id="@+id/btnLayout"
                android:layout_width="66dp"
                android:layout_height="36dp"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_control_button"
                android:text="LAYOUT"
                android:textColor="@color/control_text"
                android:textSize="11sp"
                android:textStyle="bold" />

        </LinearLayout>
    </HorizontalScrollView>

    <!-- 3. Left Movement Controls (D-Pad + Sprint) -->
    <RelativeLayout
        android:id="@+id/leftControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@android:color/transparent">

        <!-- D-Pad Container -->
        <RelativeLayout
            android:id="@+id/dpadBox"
            android:layout_width="160dp"
            android:layout_height="160dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- D-Pad Up (W) -->
            <Button
                android:id="@+id/btnUp"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentTop="true"
                android:background="@drawable/bg_dpad_button"
                android:text="▲"
                android:textColor="@color/control_text"
                android:textSize="14sp" />

            <!-- D-Pad Left (A) -->
            <Button
                android:id="@+id/btnLeft"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_dpad_button"
                android:text="◀"
                android:textColor="@color/control_text"
                android:textSize="14sp" />

            <!-- Center Sneak / Shift -->
            <Button
                android:id="@+id/btnSneak"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerInParent="true"
                android:background="@drawable/bg_dpad_button"
                android:text="◆"
                android:textColor="@color/control_text"
                android:textSize="12sp" />

            <!-- D-Pad Right (D) -->
            <Button
                android:id="@+id/btnRight"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_dpad_button"
                android:text="▶"
                android:textColor="@color/control_text"
                android:textSize="14sp" />

            <!-- D-Pad Down (S) -->
            <Button
                android:id="@+id/btnDown"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_centerHorizontal="true"
                android:layout_alignParentBottom="true"
                android:background="@drawable/bg_dpad_button"
                android:text="▼"
                android:textColor="@color/control_text"
                android:textSize="14sp" />
        </RelativeLayout>

        <!-- SPRINT Button (Ctrl) -->
        <Button
            android:id="@+id/btnSprint"
            android:layout_width="50dp"
            android:layout_height="44dp"
            android:layout_alignParentStart="true"
            android:layout_alignParentBottom="true"
            android:layout_marginStart="184dp"
            android:layout_marginBottom="20dp"
            android:background="@drawable/bg_control_button"
            android:text="RUN"
            android:textColor="@color/control_text"
            android:textSize="10sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <!-- 4. Right Action Buttons (PRI, SEC, JUMP, DROP) -->
    <RelativeLayout
        android:id="@+id/rightControlsContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:background="@android:color/transparent">

        <!-- Attack / Destroy (PRI - Left Mouse Button) -->
        <Button
            android:id="@+id/btnAttack"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="80dp"
            android:layout_marginBottom="140dp"
            android:background="@drawable/bg_control_button"
            android:text="PRI"
            android:textColor="@color/control_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Place / Use (SEC - Right Mouse Button) -->
        <Button
            android:id="@+id/btnPlace"
            android:layout_width="58dp"
            android:layout_height="58dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="144dp"
            android:layout_marginBottom="80dp"
            android:background="@drawable/bg_control_button"
            android:text="SEC"
            android:textColor="@color/control_text"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- DROP / Q (Drop held item) -->
        <Button
            android:id="@+id/btnDrop"
            android:layout_width="50dp"
            android:layout_height="44dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="80dp"
            android:background="@drawable/bg_control_button"
            android:text="DROP"
            android:textColor="@color/control_text"
            android:textSize="10sp"
            android:textStyle="bold" />

        <!-- Jump (Space) -->
        <Button
            android:id="@+id/btnJump"
            android:layout_width="64dp"
            android:layout_height="58dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:layout_marginEnd="76dp"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_control_button"
            android:text="JUMP"
            android:textColor="@color/control_text"
            android:textSize="12sp"
            android:textStyle="bold" />
    </RelativeLayout>

    <!-- 5. Bottom Center Hotbar Slots 1-9 -->
    <LinearLayout
        android:id="@+id/hotbarContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="8dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/slot1"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="@drawable/bg_control_button"
            android:text="1"
            android:textColor="@color/control_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/slot2"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_control_button"
            android:text="2"
            android:textColor="@color/control_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/slot3"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_control_button"
            android:text="3"
            android:textColor="@color/control_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/slot4"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_control_button"
            android:text="4"
            android:textColor="@color/control_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/slot5"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_control_button"
            android:text="5"
            android:textColor="@color/control_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/slot6"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_control_button"
            android:text="6"
            android:textColor="@color/control_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/slot7"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_control_button"
            android:text="7"
            android:textColor="@color/control_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/slot8"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_control_button"
            android:text="8"
            android:textColor="@color/control_text"
            android:textSize="10sp" />

        <Button
            android:id="@+id/slot9"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginStart="3dp"
            android:background="@drawable/bg_control_button"
            android:text="9"
            android:textColor="@color/control_text"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 6. Touch Layout Studio Editor Panel (Overlay when editing touch layout) -->
    <LinearLayout
        android:id="@+id/editorPanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="50dp"
        android:orientation="vertical"
        android:background="#E010141C"
        android:padding="10dp"
        android:elevation="20dp"
        android:visibility="gone">

        <!-- Header / Instructions -->
        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="TOUCH LAYOUT STUDIO • GESER TOMBOL UNTUK MENGATUR"
            android:textColor="#FF00E5FF"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Row 1: Presets -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRESET: "
                android:textColor="@color/control_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnPresetDefault"
                android:layout_width="64dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_button"
                android:text="DEFAULT"
                android:textColor="@color/control_text"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnPresetClaw"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_button"
                android:text="CLAW"
                android:textColor="@color/control_text"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnPresetErgo"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_button"
                android:text="ERGO"
                android:textColor="@color/control_text"
                android:textSize="9sp" />

            <Button
                android:id="@+id/btnPresetMinimal"
                android:layout_width="68dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_button"
                android:text="MINIMAL"
                android:textColor="@color/control_text"
                android:textSize="9sp" />
        </LinearLayout>

        <!-- Row 2: Scale, Opacity & Action Buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:gravity="center">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="UKURAN: "
                android:textColor="@color/control_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnScaleDown"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_control_button"
                android:text="-"
                android:textColor="@color/control_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnScaleUp"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_control_button"
                android:text="+"
                android:textColor="@color/control_text"
                android:textSize="13sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:text="OPASITAS: "
                android:textColor="@color/control_text"
                android:textSize="10sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAlphaDown"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_control_button"
                android:text="-"
                android:textColor="@color/control_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnAlphaUp"
                android:layout_width="36dp"
                android:layout_height="32dp"
                android:layout_marginStart="2dp"
                android:background="@drawable/bg_control_button"
                android:text="+"
                android:textColor="@color/control_text"
                android:textSize="13sp" />

            <Button
                android:id="@+id/btnResetLayout"
                android:layout_width="60dp"
                android:layout_height="32dp"
                android:layout_marginStart="10dp"
                android:background="@drawable/bg_control_button"
                android:text="RESET"
                android:textColor="#FFFF5252"
                android:textSize="9sp"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnSaveLayout"
                android:layout_width="72dp"
                android:layout_height="32dp"
                android:layout_marginStart="4dp"
                android:background="@drawable/bg_control_button"
                android:text="SIMPAN"
                android:textColor="#FF00E676"
                android:textSize="9sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
